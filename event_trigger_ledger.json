{
  "$schema": "https://json-schema.org",
  "title": "GccEventTriggerLedger",
  "description": "Defines the explicit state-transition matrix that routes real-world user choices directly to character psychological impacts and runtime engine modifications.",
  "type": "object",
  "properties": {
    "ledger_metadata": {
      "type": "object",
      "properties": {
        "project_id": { "type": "string" },
        "schema_version": { "type": "string" }
      },
      "required": ["project_id", "schema_version"]
    },
    "event_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": { "type": "string" },
          "description": { "type": "string" },
          "activation_conditions": {
            "type": "object",
            "properties": {
              "minimum_current_act": { "type": "integer", "minimum": 1, "maximum": 3 },
              "choice_severity_rating": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
            },
            "required": ["minimum_current_act", "choice_severity_rating"]
          },
          "narrative_formula_impacts": {
            "type": "object",
            "properties": {
              "target_character_id": { "type": "string" },
              "trauma_index_delta": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "redemption_index_delta": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            },
            "required": ["target_character_id", "trauma_index_delta", "redemption_index_delta"]
          },
          "render_layer_overrides": {
            "type": "object",
            "properties": {
              "spawn_addressable_asset_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "forced_environment_state": { "type": "string" }
            },
            "required": ["spawn_addressable_asset_ids"]
          }
        },
        "required": ["event_id", "description", "activation_conditions", "narrative_formula_impacts", "render_layer_overrides"]
      }
    }
  },
  "required": ["ledger_metadata", "event_triggers"]
}
